{
  "name": "@knowguard/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src prisma scripts test prisma.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:test:prepare": "dotenv -e ../../.env -- tsx scripts/prepare-test-database.ts",
    "test:e2e": "dotenv -e ../../.env -- jest"
  },
  "dependencies": {
    "@knowguard/authorization": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@knowguard/auth": "workspace:*",
    "@types/jest": "30.0.0",
    "dotenv-cli": "11.0.0",
    "fast-check": "4.10.2",
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15"
  }
}
