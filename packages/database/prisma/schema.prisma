// KnowGuard database schema.
//
// Tenant-isolation conventions (see docs/adr/0003-tenant-isolation-in-schema.md):
//  * Every tenant-owned table carries `organization_id`.
//  * Tenant-owned tables expose a composite unique key (id, organization_id).
//  * Relationships between tenant-owned rows use COMPOSITE foreign keys that include
//    organization_id, so PostgreSQL itself rejects links across organizations
//    (e.g. assigning Org A's role to Org B's member), independent of application code.
//  * Users are global identities. A user's presence in a tenant is a UserOrganization
//    membership; everything tenant-scoped about a user (roles, departments, teams,
//    sessions) references the MEMBERSHIP (user_id, organization_id), never the bare user.
//    See docs/adr/0005-identity-membership-and-sessions.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Account-level status of the identity (applies across all organizations).
enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

/// Status of a user's membership in one organization.
enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(200)
  slug      String   @unique @db.VarChar(63)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships UserOrganization[]
  departments Department[]
  teams       Team[]
  roles       Role[]

  @@map("organizations")
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased. Globally unique (MVP): login identifies the account from the email.
  email           String     @unique @db.VarChar(320)
  name            String     @db.VarChar(200)
  /// Argon2id hash. Null for invited users who have not set a password, and for future SSO-only users.
  passwordHash    String?    @map("password_hash") @db.Text
  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     UserOrganization[]
  sessions        Session[]
  invitationsSent Invitation[]       @relation("InvitationsSent")

  @@map("users")
}

/// A user's membership in an organization. The (user_id, organization_id) pair is the
/// anchor for every tenant-scoped relation of a user.
model UserOrganization {
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  roles                 UserRole[]
  departmentMemberships DepartmentMembership[]
  teamMemberships       TeamMembership[]
  sessions              Session[]
  invitations           Invitation[]

  @@id([userId, organizationId])
  /// MVP: one organization per user. Drop this index to allow multi-organization users.
  @@unique([userId], map: "user_organizations_single_org_per_user_key")
  @@index([organizationId, status])
  @@map("user_organizations")
}

/// Server-side session. The browser holds a random token; only its SHA-256 hash is stored.
/// A session is bound to one membership, which is the request's tenant context.
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// SHA-256 (hex) of the session token. The token itself is never stored.
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute expiry; idle expiry is derived from last_seen_at.
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason  String?   @map("revoked_reason") @db.VarChar(64)
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  userAgent      String?   @map("user_agent") @db.VarChar(512)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership UserOrganization @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time link that lets an INVITED member set a password and activate their membership.
/// Only the SHA-256 hash of the token is stored; the link is shown once to the inviting admin
/// (and will be emailed once an email provider exists).
model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  invitedById    String?   @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Composite FK: an invitation can only target a membership in its own organization.
  membership UserOrganization @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)
  invitedBy  User?            @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([userId, organizationId])
  @@index([organizationId])
  @@map("invitations")
}

model Department {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(200)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teams        Team[]
  members      DepartmentMembership[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@map("departments")
}

model Team {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  departmentId   String   @map("department_id") @db.Uuid
  name           String   @db.VarChar(200)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Composite FK: a team can only belong to a department of the same organization.
  department   Department       @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  members      TeamMembership[]

  @@unique([id, organizationId])
  @@unique([departmentId, name])
  @@index([organizationId])
  @@map("teams")
}

model DepartmentMembership {
  organizationId String   @map("organization_id") @db.Uuid
  departmentId   String   @map("department_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  department Department       @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership UserOrganization @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@id([departmentId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("department_memberships")
}

model TeamMembership {
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team       Team             @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership UserOrganization @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("team_memberships")
}

/// Roles are per-organization. System roles (OWNER, ADMIN, MANAGER, EMPLOYEE) are provisioned
/// into each organization with isSystem = true; custom roles use the same table.
model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Stable machine key, unique per organization (e.g. "OWNER", "SUPPORT_LEAD").
  key            String   @db.VarChar(64)
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([id, organizationId])
  @@unique([organizationId, key])
  @@map("roles")
}

/// Global permission catalog (not tenant-owned). Synced from @knowguard/authorization.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// "resource.action", e.g. "document.read".
  key         String   @unique @db.VarChar(100)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Both composite FKs share organization_id: the member and the role must be in the same tenant.
  membership UserOrganization @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)
  role       Role             @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([organizationId])
  @@map("user_roles")
}
