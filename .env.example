# KnowGuard local development environment.
# Copy to `.env` (git-ignored) and adjust. Every value below is a LOCAL-ONLY placeholder;
# production values must come from a secret manager, never from this file.

NODE_ENV=development

# ── PostgreSQL (docker compose) ─────────────────────────────────────────────
POSTGRES_USER=knowguard
POSTGRES_PASSWORD=knowguard_local_dev
POSTGRES_DB=knowguard
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knowguard:knowguard_local_dev@localhost:5432/knowguard?schema=public

# ── Redis (docker compose) ──────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=knowguard_local_dev
REDIS_URL=redis://:knowguard_local_dev@localhost:6379

# ── API (apps/api) ──────────────────────────────────────────────────────────
API_PORT=4000
LOG_LEVEL=info
# Session lifetime: absolute (hours) and idle timeout (minutes).
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=1440
# Which upstream hops may set X-Forwarded-For for the API (Express "trust proxy").
# The Next.js BFF is the API's only intended caller. In production, set this to the
# BFF's address/subnet so rate limiting uses the real client IP.
TRUST_PROXY=loopback

# ── Object storage (S3-compatible; SeaweedFS in docker compose) ───────────────────
STORAGE_PORT=8333
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=knowguard-documents
STORAGE_ACCESS_KEY_ID=knowguard_local_dev
STORAGE_SECRET_ACCESS_KEY=knowguard_local_dev_secret
# Path-style URLs are required by SeaweedFS/MinIO; AWS S3 works either way.
STORAGE_FORCE_PATH_STYLE=true
# Create the bucket at API startup if missing (development/test only; false in production).
STORAGE_AUTO_CREATE_BUCKET=true
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=25

# ── Ingestion worker (apps/worker) ────────────────────────────────────────────
# Local embedding model: document text never leaves this machine (ADR 0009).
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# Model cache (default ~/.cache/knowguard/models). Downloaded on first start (~35 MB).
# EMBEDDING_CACHE_DIR=
# Set false in production after pre-provisioning the cache (no outbound network needed).
EMBEDDING_ALLOW_REMOTE_MODELS=true
WORKER_CONCURRENCY=2
# BullMQ key prefix; environments sharing a Redis must use different prefixes.
QUEUE_PREFIX=knowguard

# ── Web (apps/web) ──────────────────────────────────────────────────────────
# Server-side base URL the Next.js server uses to reach the API.
API_URL=http://localhost:4000
# Session cookie Secure flag + "__Host-" prefix. Defaults to on in production, off otherwise.
# SESSION_COOKIE_SECURE=true

# ── Seed (packages/database) ────────────────────────────────────────────────
# Password assigned to the seeded demo users. Local development only.
SEED_USER_PASSWORD=ChangeMe-LocalOnly-2026!

# ── Tests ───────────────────────────────────────────────────────────────────
# Integration/e2e tests run against this database (created by docker/postgres/init).
# It is reset by `pnpm db:test:prepare`.
TEST_DATABASE_URL=postgresql://knowguard:knowguard_local_dev@localhost:5432/knowguard_test?schema=public
