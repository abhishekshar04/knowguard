# KnowGuard local development environment.
# Copy to `.env` (git-ignored) and adjust. Every value below is a LOCAL-ONLY placeholder;
# production values must come from a secret manager, never from this file.

NODE_ENV=development

# ── PostgreSQL (docker compose) ─────────────────────────────────────────────
POSTGRES_USER=knowguard
POSTGRES_PASSWORD=knowguard_local_dev
POSTGRES_DB=knowguard
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knowguard:knowguard_local_dev@localhost:5432/knowguard?schema=public

# ── Redis (docker compose) ──────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=knowguard_local_dev
REDIS_URL=redis://:knowguard_local_dev@localhost:6379

# ── API (apps/api) ──────────────────────────────────────────────────────────
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Web (apps/web) ──────────────────────────────────────────────────────────
# Server-side base URL the Next.js server uses to reach the API.
API_URL=http://localhost:4000

# ── Seed (packages/database) ────────────────────────────────────────────────
# Password assigned to the seeded demo users. Local development only.
SEED_USER_PASSWORD=ChangeMe-LocalOnly-2026!

# ── Tests ───────────────────────────────────────────────────────────────────
# Integration/e2e tests run against this database (created by docker/postgres/init).
# It is reset by `pnpm db:test:prepare`.
TEST_DATABASE_URL=postgresql://knowguard:knowguard_local_dev@localhost:5432/knowguard_test?schema=public
